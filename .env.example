# Local Postgres from compose.yaml. docker compose reads POSTGRES_PASSWORD from this file
# (required, no default); use the same value in DATABASE_URL. `docker compose up` rewrites the host
# of DATABASE_URL for the app container, so keep the localhost URL here for `bun run dev`.
POSTGRES_PASSWORD=password
DATABASE_URL=postgres://user:password@localhost:5432/muggle_investor
DARKFANXING_BASE_URL=https://stocks.darkfanxing.com
DARKFANXING_KEY=replace-with-upstream-key
FINMIND_TOKEN=
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=replace-with-llm-key
LLM_MODEL=replace-with-model-name
# "responses" calls POST {LLM_BASE_URL}/responses; "chat" calls /chat/completions, for an endpoint that
# only offers the older API.
LLM_API=responses
# "native" asks the endpoint for JSON-schema structured output and falls back to "prompt" by
# itself if the endpoint rejects it; set "prompt" for endpoints known not to support it.
LLM_STRUCTURED_OUTPUT=native
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=4000
CRON_SECRET=replace-with-at-least-32-random-characters
# Use codes of at least 16 random characters: the failed-attempt throttle is best-effort (per process,
# keyed on x-real-ip or the proxy-appended x-forwarded-for hop) and cannot be trusted without a proxy.
INVITE_CODES=code1,code2
# Required (every route checks it). Signs the invite-code session cookie; at least 32 random
# characters, and should be a different value from CRON_SECRET.
AUTH_SECRET=replace-with-at-least-32-random-characters
# Ask (問問看) settings; all optional. ASK_VOICE: analyst | facts_only. ASK_TOOLS: on | off
# (off sends no tools of any kind; use it when `bun run ask:probe` says the endpoint rejects tools).
ASK_VOICE=analyst
ASK_TOOLS=on
# JSON array of MCP servers Ask may call. Header values never go here: headerEnv maps a header
# name to the NAME of another env var that holds the value (never one of the app's own secrets);
# urls must be https (http only for localhost). E.g.
# [{"name":"search","url":"https://mcp.example.com/mcp","transport":"http","headerEnv":{"Authorization":"SEARCH_MCP_AUTH"},"allow":["web_search"]}]
ASK_MCP_SERVERS=[]
ASK_DAILY_MESSAGE_LIMIT=30
ASK_MAX_STEPS=6
ASK_TOOL_TIMEOUT_MS=20000
ASK_MAX_OUTPUT_TOKENS=2500
# Per answer, over every attempt and fallback: output tokens spent, tool calls started, tool calls running at once, and
# serialized tool results collected before further calls are refused.
ASK_TOTAL_OUTPUT_TOKENS=7500
ASK_MAX_TOOL_CALLS=16
ASK_TOOL_CONCURRENCY=4
ASK_TOOL_RESULT_BUDGET_BYTES=49152
# Conservative token budget of one whole model request: system prompt, tool definitions, history,
# the output and the tool results reserved. Older messages are dropped (and the reader told) to fit;
# lower it for an endpoint with a small context window.
ASK_CONTEXT_TOKENS=48000
# The input gate: a small classifier call that declines what is not about investing or personal
# finance before any tool or answering model runs. on | strict | off. `strict` refuses (503) a
# question the gate could not check; `on` lets it through. ASK_GUARD_MODEL: a smaller, faster model
# on the same endpoint (the answering model when unset); ASK_GUARD_TIMEOUT_MS: the most it may add.
ASK_GUARD=on
# ASK_GUARD_MODEL=
ASK_GUARD_TIMEOUT_MS=8000
LOG_LEVEL=info
